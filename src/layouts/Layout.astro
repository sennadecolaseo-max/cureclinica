---
import '../styles/elementor/00-reset.css';
import '../styles/elementor/01-theme.css';
import '../styles/elementor/02-header-footer.css';
import '../styles/elementor/03-frontend.min.css';
import '../styles/elementor/04-post-11.css';
import '../styles/elementor/05-widget-image.min.css';
import '../styles/elementor/06-widget-nav-menu.min.css';
import '../styles/elementor/07-sticky.min.css';
import '../styles/elementor/08-widget-heading.min.css';
import '../styles/elementor/09-widget-icon-box.min.css';
import '../styles/elementor/10-widget-icon-list.min.css';
import '../styles/elementor/11-swiper.min.css';
import '../styles/elementor/12-e-swiper.min.css';
import '../styles/elementor/13-widget-nested-carousel.min.css';
import '../styles/elementor/14-widget-video.min.css';
import '../styles/elementor/15-post-36.css';
import '../styles/elementor/16-post-23.css';
import '../styles/elementor/17-post-191.css';
import '../styles/elementor/18-style.css';
import '@fontsource/roboto/latin-300.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-600.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto-slab/latin-400.css';
import '@fontsource/albert-sans/latin-300.css';
import '@fontsource/albert-sans/latin-400.css';
import '@fontsource/albert-sans/latin-600.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/nunito/latin-600.css';
import schema from '../data/schema.json';

interface Props {
  title?: string;
  description?: string;
  pageId?: number;
  isHome?: boolean;
  pageName?: string;
  schemaType?: string;
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title = 'Home - Cure Clínica - Tricologia',
  description = 'Tratamentos avançados para saúde capilar e autoestima Atendimento personalizado para cada paciente Falar via Whatsapp tratamentos No que podemos lhe ajudar Alopecias Cicatriciais Saiba mais… Eflúvio Telógeno Saiba mais… Alopecias Androgenetica Saiba mais… Queda de Cabelo Saiba mais… Crescimento de Sobrancelhas e Barba Saiba mais… Intradermoterapia sem Dor Saiba mais… Pré e Pós-Transplante Capilar Saiba […]',
  pageId = 36,
  isHome = true,
  pageName = '',
  schemaType = 'WebPage',
  noindex = false,
  preloadImage = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/uploads/tania-machado.webp', Astro.site).href;

// Schema.org por página: reaproveita os nós do Yoast (imagem, site, organização) e
// usa URL, título, descrição e breadcrumb da própria página.
const origin = Astro.site!.origin;
const nodes: any[] = (schema as any)['@graph'];
const pick = (t: string) => nodes.find((n) => n['@type'] === t);
const { potentialAction: _a, ...website } = pick('WebSite');
const crumbs = [{ '@type': 'ListItem', position: 1, name: 'Início', item: `${origin}/` }];
if (!isHome) crumbs.push({ '@type': 'ListItem', position: 2, name: pageName || title, item: canonical });
const person = {
  '@type': 'Person',
  '@id': `${origin}/#tania-machado`,
  name: 'Tania Machado',
  jobTitle: 'Tricologista',
  image: ogImage,
  worksFor: { '@id': `${origin}/#organization` },
};
const organization = {
  ...pick('Organization'),
  founder: { '@id': `${origin}/#tania-machado` },
  '@type': ['MedicalClinic', 'Organization'],
  telephone: '+55 11 94335-2498',
  email: 'cureclinicamogi@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Barão de Jaceguai, 1708, sala 44, edifício Platinum',
    addressLocality: 'Mogi das Cruzes',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  areaServed: { '@type': 'City', name: 'Mogi das Cruzes' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '14:00' },
  ],
  sameAs: ['https://www.instagram.com/cureclinica/'],
};
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': schemaType,
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${origin}/#website` },
      about: { '@id': `${origin}/#organization` },
      primaryImageOfPage: { '@id': `${origin}/#primaryimage` },
      image: { '@id': `${origin}/#primaryimage` },
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      inLanguage: 'pt-BR',
    },
    pick('ImageObject'),
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: crumbs },
    website,
    organization,
    person,
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Cure Clínica - Tricologia" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="819" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:type" content="image/webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <link rel="icon" href={'/uploads/favicon-150x150.webp'} sizes="32x32" />
    <link rel="icon" href={'/uploads/favicon-300x300.webp'} sizes="192x192" />
    <link rel="apple-touch-icon" href={'/uploads/favicon-300x300.webp'} />
    <meta name="msapplication-TileImage" content={'/uploads/favicon-300x300.webp'} />


    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

    <!-- GTM e Meta Pixel: carregam após o load (ou na 1ª interação) para não competir com o LCP/TBT -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      !(function (f, n) {
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
      })(window);
      fbq('init', '1617279699509270');
      fbq('track', 'PageView');
      (function () {
        var started = false;
        function load() {
          if (started) return;
          started = true;
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-MP7LW64V';
          document.head.appendChild(g);
          var p = document.createElement('script');
          p.async = true;
          p.src = 'https://connect.facebook.net/en_US/fbevents.js';
          document.head.appendChild(p);
        }
        ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
          window.addEventListener(e, load, { once: true, passive: true });
        });
        window.addEventListener('load', function () {
          setTimeout(load, 2500);
        });
      })();
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1617279699509270&ev=PageView&noscript=1" alt="" />
    </noscript>
    <!-- End GTM / Meta Pixel -->
  </head>
  <body class={`${isHome ? 'home ' : ''}wp-singular page-template-default page page-id-${pageId} wp-custom-logo wp-embed-responsive wp-theme-hello-elementor wp-child-theme-hello-theme-child-master hello-elementor-default elementor-default elementor-kit-11 elementor-page elementor-page-${pageId}`}>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MP7LW64V"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link screen-reader-text" href="#content">Ir para o conteúdo</a>
    <slot />
  </body>
</html>
