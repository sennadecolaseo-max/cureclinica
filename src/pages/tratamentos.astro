---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TratamentosContent from '../components/TratamentosContent.astro';
import '../styles/pages/tratamentos.css';
import '../styles/pages/prp.css';
---

<Layout
  title="Tratamentos Capilares em Mogi das Cruzes | Cure Clínica"
  description="Alopecia, eflúvio telógeno, transplante, PRP capilar, barba e sobrancelhas em Mogi das Cruzes. Avaliação individual com tricologista."
  pageName="Tratamentos"
  pageId={239}
  isHome={false}
>
  <SiteHeader />
  <main id="content" class="site-main post-239 page type-page status-publish hentry">
    <div class="page-content">
      <div data-elementor-type="wp-page" data-elementor-id="239" class="elementor elementor-239" data-elementor-post-type="page">
        <TratamentosContent />
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
