<script>
  // Menu mobile
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const dropdown = document.getElementById('nav-dropdown');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    dropdown?.classList.toggle('is-open', !open);
  });
  dropdown?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      dropdown.classList.remove('is-open');
    }),
  );

  // Carrossel de depoimentos: autoplay 5s, loop, pausa no hover, 1 slide (2 no tablet), espaço 10px
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const viewport = root.querySelector<HTMLElement>('.carousel__viewport')!;
    const track = root.querySelector<HTMLElement>('.carousel__track')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel__slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel__dot'));
    const GAP = 10;
    let index = 0;
    let perView = 1;
    let timer: number | undefined;
    let paused = false;

    const maxIndex = () => Math.max(0, slides.length - perView);

    const layout = () => {
      const w = window.innerWidth;
      perView = w >= 768 && w <= 1024 ? 2 : 1;
      const slideW = (viewport.clientWidth - GAP * (perView - 1)) / perView;
      slides.forEach((s) => {
        s.style.width = `${slideW}px`;
        s.style.marginRight = `${GAP}px`;
      });
      go(Math.min(index, maxIndex()), false);
    };

    const go = (i: number, animate = true) => {
      index = i;
      const slideW = slides[0].getBoundingClientRect().width + GAP;
      track.style.transition = animate ? '' : 'none';
      track.style.transform = `translate3d(${-index * slideW}px,0,0)`;
      dots.forEach((d, n) => d.setAttribute('aria-current', String(n === index)));
      slides.forEach((s, n) => {
        const visible = n >= index && n < index + perView;
        s.setAttribute('aria-hidden', String(!visible));
        if (visible) s.removeAttribute('inert');
        else s.setAttribute('inert', '');
      });
    };

    const next = () => go(index >= maxIndex() ? 0 : index + 1);
    const start = () => {
      stop();
      timer = window.setInterval(() => {
        if (!paused) next();
      }, 5000);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
    };

    dots.forEach((d, n) =>
      d.addEventListener('click', () => {
        go(Math.min(n, maxIndex()));
        start();
      }),
    );
    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = false));

    // Arrastar no toque
    let startX = 0;
    viewport.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    viewport.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) {
        go(dx < 0 ? (index >= maxIndex() ? 0 : index + 1) : index === 0 ? maxIndex() : index - 1);
        start();
      }
    });

    window.addEventListener('resize', layout);
    layout();
    start();
  }
</script>
