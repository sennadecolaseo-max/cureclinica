---
import Layout from '../layouts/Layout.astro';
import { asset, WHATSAPP_URL } from '../data/assets';

const menu = [
  { label: 'Home', href: '/' },
  { label: 'Tratamentos', href: '/tratamentos/' },
  { label: 'Sobre Nós', href: '/#quem-somos' },
  { label: 'Blog', href: '/blog/' },
];

const treatments = [
  { title: 'Alopecias Cicatriciais', href: '/tratamentos/#alopercias-cicatriciais', img: '2026/01/alopecias-cicatriciais-corte.webp', w: 663, h: 668 },
  { title: 'Eflúvio Telógeno', href: '/tratamentos/#efluvio-telogeno', img: '2026/01/efluvio-telogeno-768x1024.webp', w: 768, h: 1024 },
  { title: 'Alopecias Androgenetica', href: '/tratamentos/#alopercias-androgenetica', img: '2026/01/alopecia-androgenetica-1.webp', w: 253, h: 268 },
  { title: 'Queda de Cabelo', href: '/queda-de-cabelo/', img: '2026/02/queda-de-cabelo.webp', w: 477, h: 464 },
  { title: 'Crescimento de Sobrancelhas e Barba', href: '/tratamentos/#barba-sobrancelhas', img: '2026/02/barba-768x768.webp', w: 768, h: 768 },
  { title: 'Intradermoterapia sem Dor', href: '/tratamentos/#intradermoterapia-sem-dor', img: '2026/01/intradermoterapia-sem-dor.webp', w: 800, h: 737 },
  { title: 'Pré e Pós-Transplante Capilar', href: '/tratamentos/#transplante', img: '2026/02/transplante.webp', w: 800, h: 576 },
  { title: 'Pré e Pós-Química Capilar', href: '/tratamentos/#quimica', img: '2026/02/quimica-1024x825.webp', w: 800, h: 645 },
];

const testimonials = [
  {
    img: '2026/01/Prancheta-3-copia-3-1.webp',
    w: 104,
    h: 104,
    text: 'Trabalhei com a Tania Machado em  um hospital por alguns anos. Posso afirmar que se trata de profissional competente, estudiosa, comprometida em se atualizar constantemente.',
    name: 'Dr. Manoel Leitão Neto Costa',
    role: 'Médico cardiologista e intesivista',
  },
  {
    img: '2026/01/11.webp',
    w: 361,
    h: 451,
    text: 'Sou super cético com alguns assuntos, principalmente quando se trata de saúde. Ao conhecer a Laserterapia, fiquei relutante quanto a sua eficiência e eficácia, mas para minha grata surpresa o resultado foi espetacular. Cumpriu tudo que havia sido prometido e foi muito além. Simplesmente fantástico. Recomendo a todos!',
    name: 'Wladimir Machado',
    role: 'Empresário',
  },
  {
    img: '2026/01/Prancheta-3-copia-2.webp',
    w: 308,
    h: 379,
    text: 'Na CURE você encontra uma profissional qualificada, competente, que trabalha com respeito e ética, além de dominar sua área de atuação.',
    name: 'Elaine Mota',
    role: 'Enfermeira de Controle de Infecção Hospitalar',
  },
  {
    img: '2026/01/plancheta-4.webp',
    w: 447,
    h: 632,
    text: 'Simplesmente estou amando o resultado, cada dia mais. Muito obrigada. Entrei na sua clínica muito triste, só chorava por causa da minha queda de cabelo e hoje, eu só tenho que agradecer a Deus por ter colocado uma ótima profissional na minha vida. Você devolveu minha autoestima. Estou feliz e agradeço por você fazer parte dessa vitória.',
    name: 'Simone Valeria',
    role: 'Cliente',
  },
];

const about = [
  'Eu sei, na pele, o que a queda de cabelo é capaz de fazer com a autoestima de alguém. Não foi em livro que aprendi isso, foi no espelho.',
  'Sou tricologista, pós-graduada e fundadora da minha própria clínica, mas antes de cuidar de qualquer paciente, precisei cuidar de mim. Depois de sofrer com dermatite e queda causada por químicas, percebi que não bastava “aceitar” aquele processo: eu precisava entender, em profundidade, o que estava acontecendo.',
  'Foi essa inconformidade que me levou à tricologia. Estudei, me especializei e descobri que, por trás de cada fio que cai, existe uma história, um estilo de vida, um contexto emocional e um corpo pedindo atenção. Cada caso é um caso. Você é único.',
  'Hoje, uno ciência aplicada, tecnologia e escuta empática para construir tratamentos individualizados, sem promessas milagrosas e com total responsabilidade. Transformo a dor que vivi em um compromisso diário: ajudar você a recuperar não só a densidade dos fios, mas a confiança de se olhar no espelho e se reconhecer de novo.',
  'Eu não trato apenas cabelo; eu cuido da vida de quem está perdendo os cabelos.',
  'Sempre digo para meus pacientes: Apaixone-se pelo processo, pela rotina diária que vai salvar seu cabelo!',
];

const mapsUrl =
  'https://www.google.com/maps/place/R.+Bar%C3%A3o+de+Jaceguai,+1708+-+Sala+44+-+Parque+Monte+Libano,+Mogi+das+Cruzes+-+SP,+08780-100/data=!4m2!3m1!1s0x94cdd839ca29e681:0x7868f2fca69c1c35?sa=X&ved=1t:242&ictx=111';
---

<Layout>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-header__logo" href="/">
        <img src={asset('2025/10/cure-clinica-logo-branca.webp')} width="129" height="41" alt="Cure Clínica - Tricologia" />
      </a>

      <nav class="nav" aria-label="Menu">
        <ul>
          {menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}
        </ul>
      </nav>

      <div class="header-cta">
        <a class="btn-small" href={WHATSAPP_URL} target="_blank" rel="noopener">Agendar Consulta</a>
      </div>

      <button class="menu-toggle" type="button" aria-label="Menu Toggle" aria-expanded="false" aria-controls="nav-dropdown">
        <svg class="icon-open" aria-hidden="true" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg"><path d="M104 333H896C929 333 958 304 958 271S929 208 896 208H104C71 208 42 237 42 271S71 333 104 333ZM104 583H896C929 583 958 554 958 521S929 458 896 458H104C71 458 42 487 42 521S71 583 104 583ZM104 833H896C929 833 958 804 958 771S929 708 896 708H104C71 708 42 737 42 771S71 833 104 833Z"></path></svg>
        <svg class="icon-close" aria-hidden="true" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg"><path d="M742 167L500 408 258 167C246 154 233 150 217 150 196 150 179 158 167 167 154 179 150 196 150 212 150 229 154 242 171 254L408 500 167 742C138 771 138 800 167 829 196 858 225 858 254 829L496 587 738 829C750 842 767 846 783 846 800 846 817 842 829 829 842 817 846 800 846 783 846 767 842 750 829 738L587 496 829 258C838 250 846 233 846 217 846 200 842 183 829 171 817 158 800 154 783 154 767 154 750 158 738 171L500 408 742 167Z"></path></svg>
      </button>

      <nav id="nav-dropdown" class="nav-dropdown" aria-label="Menu">
        {menu.map((m) => <a href={m.href}>{m.label}</a>)}
      </nav>
    </div>
  </header>

  <main id="content">
    <section class="hero" style={`background-image:url(${asset('2026/01/fundo-banner-5.webp')})`}>
      <div class="hero__inner">
        <div class="hero__text">
          <h1>Tratamentos avançados para saúde capilar e autoestima</h1>
          <p>Atendimento personalizado para cada paciente</p>
          <a class="btn" href={WHATSAPP_URL} target="_blank" rel="noopener">Falar via Whatsapp</a>
        </div>
        <div class="hero__image">
          <img
            src={asset('2026/01/tania-machado.webp')}
            width="800"
            height="1000"
            fetchpriority="high"
            decoding="async"
            alt="Tania Machado, tricologista e fundadora da Cure Clínica"
          />
        </div>
      </div>
    </section>

    <section class="treatments">
      <div class="treatments__inner">
        <span class="tag tag--archivo">tratamentos</span>
        <h2>No que podemos lhe ajudar</h2>
        <div class="treatments__grid">
          {treatments.map((t, i) => (
            <a class="card" href={t.href}>
              <img
                src={asset(t.img)}
                width={t.w}
                height={t.h}
                alt={t.title}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="card__title"><h3>{t.title}</h3></div>
              <p>Saiba mais...</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="testimonials">
      <div class="testimonials__inner">
        <div class="testimonials__head">
          <span class="tag">depoimentos</span>
          <h2>O que dizem sobre nós</h2>
        </div>

        <div class="carousel" data-carousel role="region" aria-roledescription="carousel" aria-label="Carrossel">
          <div class="carousel__viewport">
            <div class="carousel__track">
              {testimonials.map((t, i) => (
                <div class="carousel__slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${testimonials.length}`}>
                  <div class="slide">
                    <div class="slide__card">
                      <img src={asset(t.img)} width={t.w} height={t.h} alt={t.name} loading="lazy" decoding="async" />
                      <div class="slide__body">
                        <p class="slide__text">{t.text}</p>
                        <div class="slide__author">
                          <p class="slide__name">{t.name}</p>
                          <p class="slide__role">{t.role}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="carousel__dots">
            {testimonials.map((_, i) => (
              <button class="carousel__dot" type="button" aria-label={`Ir para o slide ${i + 1}`} data-dot={i}></button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="about" id="quem-somos">
      <div class="about__inner">
        <div class="about__col about__video">
          <video src={asset('2026/01/quem-sou.mp4')} controls preload="metadata" controlslist="nodownload"></video>
        </div>
        <div class="about__col">
          <div class="about__title">
            <img src={asset('2026/01/download.png')} width="53" height="95" alt="" loading="lazy" decoding="async" />
            <h2>Quem sou</h2>
          </div>
          <div class="about__text">
            <p>
              {about.map((line, i) => (
                <>
                  {line}
                  {i < about.length - 1 && <br />}
                </>
              ))}
            </p>
            <p>Tania Machado</p>
          </div>
        </div>
      </div>
    </section>
  </main>

